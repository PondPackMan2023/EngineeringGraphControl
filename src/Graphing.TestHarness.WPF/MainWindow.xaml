<Window
    x:Class="Graphing.TestHarness.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Dev.Wpf.Controls;assembly=Dev.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Graphing.TestHarness.WPF.Core.ViewModels;assembly=Graphing.TestHarness.WPF.Core"
    Title="EngineeringGraphControl - WPF Test Harness"
    Width="1280"
    Height="760"
    MinWidth="1024"
    MinHeight="640"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <DockPanel Background="{DynamicResource ControlBackgroundBrush}" LastChildFill="True">
        <controls:ToolbarHostControl
            DockPanel.Dock="Top"
            ItemsSource="{Binding Toolbar.PrimaryToolbarItems}"
            ToolbarId="{Binding Toolbar.PrimaryToolbarId}"
            ToolbarRegistry="{Binding Toolbar.ToolbarRegistry}" />

        <!--
            Shell projection layout.
            SidebarRegion projects the active mode's sidebar view model.
            MainContentRegion projects the active mode's main content view model.
            When the active mode provides no sidebar (Sidebar = null), the
            SidebarRegion collapses to zero width via the DataTrigger below.
        -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SidebarRegion -->
            <ContentControl
                Grid.Column="0"
                Width="220"
                Content="{Binding SidebarViewModel}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SidebarViewModel}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- MainContentRegion -->
            <ContentControl
                Grid.Column="1"
                Content="{Binding MainContentViewModel}" />
        </Grid>
    </DockPanel>
</Window>
