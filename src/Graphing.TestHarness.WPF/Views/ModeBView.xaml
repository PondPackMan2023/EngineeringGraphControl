<UserControl
    x:Class="Graphing.TestHarness.WPF.Views.ModeBView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:graph="clr-namespace:Graphing.Controls;assembly=Graphing.Controls.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <!--<Grid>
        <Border
            Margin="16"
            Padding="10"
            Background="{DynamicResource ControlBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1">
            <graph:EngineeringGraphControl
                GraphModel="{Binding GraphModel}"
                ZoomEnabled="{Binding ZoomEnabled}"
                ZoomExtentsRequestVersion="{Binding ZoomExtentsRequestVersion}" />
        </Border>
    </Grid>-->
    <Grid>
        <Border
            Padding="16"
            Background="{DynamicResource ControlBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{Binding Title}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource TextBrush}"
                    Text="{Binding Description}"
                    TextWrapping="Wrap" />

                <graph:EngineeringGraphControl
                    Grid.Row="3"
                    MinHeight="260"
                    GraphModel="{Binding GraphModel}"
                    ZoomEnabled="True" />
            </Grid>
        </Border>
    </Grid>

</UserControl>
